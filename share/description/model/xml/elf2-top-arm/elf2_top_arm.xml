    <!-- joint pos sensor -->
    <jointpos name="r_shld_y_joint_pos" joint="r_shld_y_joint" />
    <jointpos name="r_shld_x_joint_pos" joint="r_shld_x_joint" />
    <jointpos name="r_shld_z_joint_pos" joint="r_shld_z_joint" />
