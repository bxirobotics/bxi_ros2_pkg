    <motor name="l_elb_z_joint" joint="l_elb_z_joint" gear="1" ctrllimited='true' ctrlrange='-7 7' />

    <motor name="l_wrist_y_joint" joint="l_wrist_y_joint" gear="1" ctrllimited='true' ctrlrange='-7 7' />
    <motor name="l_wrist_x_joint" joint="l_wrist_x_joint" gear="1" ctrllimited='true' ctrlrange='-7 7' />

