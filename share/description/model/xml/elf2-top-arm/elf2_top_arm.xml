    <jointpos name="l_elb_z_joint_vel" joint="l_elb_z_joint" />
    <jointpos name="l_wrist_y_joint_vel" joint="l_wrist_y_joint" />
    <jointpos name="l_wrist_x_joint_vel" joint="l_wrist_x_joint" />


